{
  "tasks": [
    "bci_errp",
    "seizure_detection",
    "attention_state"
  ],
  "methods": [
    "raw",
    "bandpass",
    "asr",
    "ic_unet",
    "ica"
  ],
  "classifiers": [
    "logistic_regression",
    "svm",
    "random_forest",
    "lightgbm",
    "mlp",
    "eegnet",
    "vit",
    "mobilenet"
  ],
  "repeats": 10,
  "base_seed": 0,
  "output_dir": "output",
