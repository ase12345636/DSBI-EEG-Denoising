{
  "tasks": [
    "bci_errp",
    "seizure_detection",
    "attention_state"
  ],
  "methods": [
    "raw",
    "bandpass",
    "asr",
    "ic_unet",
    "ica"
  ],
  "classifiers": [
    "logistic_regression",
    "svm",
    "random_forest",
    "lightgbm",
    "mlp",
    "eegnet"
  ],
  "repeats": 10,
  "legacy_mode": false,
  "output_dir": "output",
  "cache_dir": ".cache",
  "stft": {
    "window": "hann",
    "nperseg": 256,
    "overlap_fraction": 0.5,
    "boundary": "zeros",
    "padded": true,
    "power": true
  },
  "eegnet": {
    "epochs": 150,
    "batch_size": 32,
    "patience": 10,
    "monitor": "val_loss",
    "verbose": 0
  },
  "ic_unet": {
    "checkpoint": "BEST_checkpoint.pth.tar",
    "recording_chunk_seconds": 30,
    "recording_overlap_seconds": 2
  },
  "ica": {
    "decomposition": "extended_infomax",
    "component_labeler": "iclabel",
    "random_state": 97,
    "fit_sample_budget_seconds": 300.0,
    "keep_labels": [
      "brain",
      "other"
    ],
    "fit_reference": "common_average",
    "fit_band_hz": [
      1.0,
      100.0
    ]
  }
}