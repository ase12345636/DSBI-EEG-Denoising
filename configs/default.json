    "boundary": "zeros",
    "padded": true
  },
  "eegnet": {
    "epochs": 150,
    "batch_size": 32,
    "patience": 10,
    "verbose": 0
  },
  "asr": {
    "cutoff": 5
  },
  "ic_unet": {},
  "calibration": {
    "max_seconds": 300.0,
    "block_count": 10
  },
  "ica": {
    "random_state": 97
  }
